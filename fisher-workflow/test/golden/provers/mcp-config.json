{
  "isabelle": {
    "mcpServers": {
      "isabelle": {
        "args": [
          "--from",
          "isabelle-mcp==0.6.0",
          "python",
          "/work/state/isabelle-mcp/isabelle_mcp_shim.py"
        ],
        "command": "uvx",
        "env": {
          "ISABELLE_PROJECT_PATH": "/work/proj"
        },
        "type": "stdio"
      }
    }
  },
  "rocq": {
    "mcpServers": {
      "rocq": {
        "args": [
          "--from",
          "git+https://github.com/LLM4Rocq/rocq-mcp@6983113d0844c0b7f987c79dab13988445109bfb",
          "rocq-mcp"
        ],
        "command": "uvx",
        "env": {
          "ROCQ_PROJECT_PATH": "/work/proj",
          "ROCQ_WORKSPACE": "/work/proj"
        },
        "type": "stdio"
      }
    }
  }
}
