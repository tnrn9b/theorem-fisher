  "blank-override": {
    "args": [
      "--from",
      "git+https://github.com/LLM4Rocq/rocq-mcp@6983113d0844c0b7f987c79dab13988445109bfb",
      "rocq-mcp"
    ],
    "command": "uvx",
    "connect_timeout": 300,
    "cwd": "/work/proj",
    "env": {
      "ROCQ_PROJECT_PATH": "/work/proj",
      "ROCQ_WORKSPACE": "/work/proj"
    },
    "fisher_messages": true,
    "reconnect_on_exit": true,
    "timeout": 300,
    "tools": {
      "include": [
        "rocq_compile",
